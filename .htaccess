# Clean URL: https://website.codingexpo.org/ (assets stay under getizy/files/)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect old long URL and /index.html to site root
  RewriteRule ^getizy/files/index-3-one-page\.html$ / [R=301,L]
  RewriteRule ^index\.html$ / [R=301,L]

  # Thank-you page after form submit
  RewriteRule ^thankyou/?$ getizy/files/thankyou.html [L]

  # Serve homepage at /
  RewriteRule ^$ getizy/files/index-3-one-page.html [L]
</IfModule>
